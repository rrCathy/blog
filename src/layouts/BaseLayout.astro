---
import '../styles/global.css'
import 'katex/dist/katex.min.css'
import '@groupviz/react/theme.css'

interface Props {
  title: string
  description?: string
  pageTitle?: string
}

const { title, description = '数学笔记 · 技术记录', pageTitle } = Astro.props
const fullTitle = pageTitle ? `${pageTitle} · ${title}` : title
const url = Astro.url
// base 前缀(如 /blog/)，结尾带 '/'
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={title}
      href={base + 'rss.xml'}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={base}>
          <b>rrCathy</b> · Blog
        </a>
        <nav class="site-nav">
          <a href="/">项目</a>
          <a href={base} aria-current="page">博客</a>
          <a href="https://github.com/rrCathy" target="_blank" rel="noopener">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <span>© 2026 rrCathy</span>
        <span>
          由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建 ·
          交互插图由 <a href="https://github.com/rrCathy/GroupViz" target="_blank" rel="noopener">@groupviz/react</a> 驱动
        </span>
      </div>
    </footer>
  </body>
</html>
