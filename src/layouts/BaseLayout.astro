---
import '../styles/global.css'
import 'katex/dist/katex.min.css'
import '@groupviz/react/theme.css'

interface Props {
  title: string
  description?: string
  pageTitle?: string
  /** 社交分享图(og:image)；传 base 下的相对路径(如 '/blog/covers/x.png') */
  image?: string
}

const { title, description = '数学笔记 · 技术记录', pageTitle, image } = Astro.props
const fullTitle = pageTitle ? `${pageTitle} · ${title}` : title
const url = Astro.url
// base 前缀(如 /blog/)，结尾带 '/'
const base = import.meta.env.BASE_URL
// og:image 转绝对地址(分享卡片要求绝对 URL)
const ogImage = image ? new URL(image, Astro.site).toString() : undefined
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={title}
      href={base + 'rss.xml'}
    />
    <script is:inline>
      // 主题初始化:localStorage 优先,否则跟随系统;写 <html data-theme>
      // groupviz 视图与本站排版共用该属性切换浅/深。
      ;(function () {
        var KEY = 'blog-theme'
        var theme = 'light'
        try {
          var saved = localStorage.getItem(KEY)
          if (saved === 'dark' || saved === 'light') theme = saved
          else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)
            theme = 'dark'
        } catch (e) {}
        document.documentElement.dataset.theme = theme
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={base}>
          <b>rrCathy</b> · Blog
        </a>
        <nav class="site-nav">
          <a href="/">项目</a>
          <a href={base} aria-current="page">博客</a>
          <a href="https://github.com/rrCathy" target="_blank" rel="noopener">GitHub ↗</a>
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="切换浅色/深色主题"
            title="切换浅色/深色主题"
          >
            <span class="icon-sun" aria-hidden="true">☀</span>
            <span class="icon-moon" aria-hidden="true">☾</span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <span>© 2026 rrCathy</span>
        <span>
          由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建 ·
          交互插图由 <a href="https://github.com/rrCathy/GroupViz" target="_blank" rel="noopener">@groupviz/react</a> 驱动
        </span>
      </div>
    </footer>
    <script is:inline>
      ;(function () {
        var btn = document.getElementById('theme-toggle')
        if (!btn) return
        btn.addEventListener('click', function () {
          var html = document.documentElement
          var next = html.dataset.theme === 'dark' ? 'light' : 'dark'
          html.dataset.theme = next
          try {
            localStorage.setItem('blog-theme', next)
          } catch (e) {}
        })
      })()
    </script>
  </body>
</html>
