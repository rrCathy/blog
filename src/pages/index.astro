---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const base = import.meta.env.BASE_URL

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
}

// 标签聚合(按出现顺序去重)
const tags: string[] = []
for (const p of all) for (const t of p.data.tags) if (!tags.includes(t)) tags.push(t)
---

<BaseLayout
  title="rrCathy 的博客"
  pageTitle="rrCathy · Blog"
  description="数学笔记与技术记录 —— 群论可视化、前端开发等"
>
  <div class="wrap">
    <section class="blog-hero">
      <h1>rrCathy 的博客</h1>
      <p class="sub">数学笔记与开发记录 · 文章里的插图是可以交互的活图 —— 试试悬停与拖拽。</p>
    </section>

    <div class="tag-filter" aria-label="按标签筛选文章">
      {tags.map((t) => (
        <button type="button" class="tag-chip" data-tag={t} aria-pressed="false">
          #{t}
        </button>
      ))}
    </div>

    <ul class="post-list">
      {
        all.map((post) => (
          <li class="post-item" data-tags={post.data.tags.join(',')}>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {fmtDate(post.data.pubDate)}
              </time>
              {post.data.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <h2><a href={base + post.id + '/'}>{post.data.title}</a></h2>
            {post.data.description && (
              <p class="post-excerpt">{post.data.description}</p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="post-empty" hidden>该标签下暂无文章。</p>
  </div>
</BaseLayout>

<script>
  // 标签筛选:点一个 chip 过滤列表,再点同一个取消;chip 是真按钮,aria-pressed 同步状态
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.tag-filter .tag-chip')]
  const items = [...document.querySelectorAll<HTMLElement>('.post-item')]
  const empty = document.querySelector<HTMLElement>('.post-empty')
  let active: string | null = null

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const t = chip.dataset.tag ?? ''
      active = active === t ? null : t
      chips.forEach((c) =>
        c.setAttribute('aria-pressed', String(active !== null && c === chip)),
      )
      let shown = 0
      items.forEach((item) => {
        const hit = active === null || (item.dataset.tags ?? '').split(',').includes(active)
        item.hidden = !hit
        if (hit) shown++
      })
      if (empty) empty.hidden = shown > 0
    })
  })
</script>
