---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCover from '../../components/PostCover.astro'
import { getAllSeries } from '../../lib/series'
import { tagTone } from '../../lib/tag-tone'

export async function getStaticPaths() {
  const series = await getAllSeries()
  return series.map((s) => ({ params: { name: s.slug }, props: { series: s } }))
}

const { series } = Astro.props
const base = import.meta.env.BASE_URL

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
}
---

<BaseLayout
  title="rrCathy 的博客"
  pageTitle={`${series.name} · 系列`}
  description={`《${series.name}》系列，共 ${series.posts.length} 篇，按发布顺序排列。`}
>
  <div class="wrap">
    <section class="blog-hero">
      <p class="series-eyebrow">系列</p>
      <h1>{series.name}</h1>
      <p class="sub">共 {series.posts.length} 篇 · 按发布顺序</p>
    </section>

    <ul class="post-list">
      {
        series.posts.map((post, i) => (
          <li class="post-item" data-tags={post.data.tags.join(',')}>
            <div class="post-item-body">
              <div class="post-meta">
                <span class="series-idx">第 {i + 1} 篇</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmtDate(post.data.pubDate)}
                </time>
                {post.data.tags.map((t) => (
                  <span class="tag" data-tone={tagTone(t)}>{t}</span>
                ))}
              </div>
              <h2><a href={base + post.id + '/'}>{post.data.title}</a></h2>
              {post.data.description && <p class="post-excerpt">{post.data.description}</p>}
            </div>
            <PostCover
              cover={post.data.cover}
              variant="card"
              seed={post.id}
              title={post.data.title}
            />
          </li>
        ))
      }
    </ul>

    <p class="series-back"><a href={base}>← 全部文章</a></p>
  </div>
</BaseLayout>
