---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCover from '../components/PostCover.astro'
import ShareBar from '../components/ShareBar.tsx'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const base = import.meta.env.BASE_URL

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
}

// 目录:h2/h3,slug 与 Astro 给标题自动生成的 id 一致
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3)

// 文末导航:上一篇 = 更早发布,下一篇 = 更新发布(draft 不参与)
const all = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const idx = all.findIndex((p) => p.id === post.id)
const newer = idx > 0 ? all[idx - 1] : null
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null

// issue 预填标题:JSX/Astro 双引号属性里的 {expr} 不插值,必须走模板字符串 + 编码
const issueUrl = `https://github.com/rrCathy/blog/issues/new?title=${encodeURIComponent(`关于「${post.data.title}」`)}`

// og:image:静态图片封面(img/字符串)或引擎封面的海报;纯引擎无海报时不输出
const coverData = post.data.cover
const coverOgPath =
  (typeof coverData === 'string' ? coverData : coverData?.img ?? coverData?.poster ?? null) ?? null
const coverOgUrl = coverOgPath ? base + coverOgPath.replace(/^\//, '') : undefined

// 分享:文章绝对 URL(进文案/二维码);封面静图用**同源相对路径**——canvas 画跨域图
// 会污染画布致 toBlob 抛 SecurityError,且本地 preview 下绝对域不可达
const siteOrigin = Astro.site ?? 'https://rrcathy.github.io'
const postUrl = new URL(base + post.id + '/', siteOrigin).href
const shareImgUrl = coverOgUrl ?? null
---

<BaseLayout
  title="rrCathy 的博客"
  pageTitle={post.data.title}
  description={post.data.description}
  image={coverOgUrl}
>
  <article class="wrap article">
    {post.data.cover ? (
      <header class="article-header head-card">
        <div class="head-card-text">
          <div class="post-meta">
            <a href={base}>← 全部文章</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {fmtDate(post.data.pubDate)}
            </time>
            {post.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <h1>{post.data.title}</h1>
        </div>
        <div class="head-card-cover">
          <PostCover
            cover={post.data.cover}
            variant="head"
            seed={post.id}
            title={post.data.title}
          />
        </div>
      </header>
    ) : (
      <header class="article-header">
        <div class="post-meta">
          <a href={base}>← 全部文章</a>
          <time datetime={post.data.pubDate.toISOString()}>
            {fmtDate(post.data.pubDate)}
          </time>
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <h1>{post.data.title}</h1>
      </header>
    )}

    {toc.length > 3 && (
      <nav class="toc" aria-label="文章目录">
        <p class="toc-title">目录</p>
        <ul>
          {toc.map((h) => (
            <li class={h.depth === 3 ? 'toc-l3' : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="article-body">
      <Content />
    </div>

    {(older || newer) && (
      <nav class="post-nav" aria-label="上一篇与下一篇">
        {older && (
          <a class="post-nav-item" href={base + older.id + '/'}>
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class="post-nav-item next" href={base + newer.id + '/'}>
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <aside class="article-foot">
      <div class="foot-row">
        <span class="foot-label">时间</span>
        <span>
          发布于 <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updateDate && (
            <>
              {' · '}最后更新{' '}
              <time datetime={post.data.updateDate.toISOString()}>
                {fmtDate(post.data.updateDate)}
              </time>
            </>
          )}
        </span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="foot-row">
          <span class="foot-label">标签</span>
          <span>{post.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
        </div>
      )}
      <div class="foot-row">
        <span class="foot-label">联系</span>
        <span>
          <a href="https://github.com/rrCathy" target="_blank" rel="noopener">GitHub ↗</a>
          {' · '}
          <a href="mailto:bluejam001@163.com">bluejam001@163.com</a>
        </span>
      </div>
      <div class="foot-row">
        <span class="foot-label">评论</span>
        <span>
          发现错误或想深入讨论？到{' '}
          <a href={issueUrl} target="_blank" rel="noopener">
            仓库 Issue
          </a>{' '}
          开一条即可，我会收到通知。
        </span>
      </div>
      <div class="foot-row">
        <span class="foot-label">分享</span>
        {/* client:idle 带超时兜底：活图多的长文页持续渲染会让 requestIdleCallback
            长期饿死（第四篇 21 个 island 实测永不 hydrate），timeout 保证最迟 2s 启动 */}
        <ShareBar
          client:idle={{ timeout: 2000 }}
          title={post.data.title}
          description={post.data.description ?? null}
          url={postUrl}
          date={fmtDate(post.data.pubDate)}
          coverSrc={shareImgUrl}
          slug={post.id}
          siteName="rrCathy 的博客"
        />
      </div>
    </aside>
  </article>

  <script>
    // 代码块复制按钮:把每个 pre 包进 .pre-wrap,右上角挂按钮
    document.querySelectorAll<HTMLElement>('.article-body pre').forEach((pre) => {
      const wrap = document.createElement('div')
      wrap.className = 'pre-wrap'
      pre.replaceWith(wrap)
      wrap.appendChild(pre)

      const btn = document.createElement('button')
      btn.type = 'button'
      btn.className = 'copy-btn'
      btn.textContent = '复制'
      btn.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.innerText ?? ''
        try {
          await navigator.clipboard.writeText(text)
          btn.textContent = '已复制 ✓'
          btn.classList.add('ok')
        } catch {
          btn.textContent = '复制失败'
        }
        setTimeout(() => {
          btn.textContent = '复制'
          btn.classList.remove('ok')
        }, 1500)
      })
      wrap.appendChild(btn)
    })

    // 目录滚动高亮:观察正文 h2/h3,视口上带内命中的最后一节为当前节
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')]
    if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
      const byId = new Map(tocLinks.map((a) => [a.getAttribute('href')!.slice(1), a]))
      let current: string | null = null
      const setActive = () => {
        tocLinks.forEach((a) =>
          a.classList.toggle('active', current !== null && a.getAttribute('href') === `#${current}`),
        )
      }
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) current = e.target.id
          }
          setActive()
        },
        { rootMargin: '-70px 0px -66% 0px' },
      )
      byId.forEach((_, id) => {
        const h = document.getElementById(id)
        if (h) obs.observe(h)
      })
    }
  </script>
</BaseLayout>
