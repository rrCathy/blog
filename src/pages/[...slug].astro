---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const base = import.meta.env.BASE_URL

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
}
---

<BaseLayout
  title="rrCathy 的博客"
  pageTitle={post.data.title}
  description={post.data.description}
>
  <article class="wrap article">
    <header class="article-header">
      <div class="post-meta">
        <a href={base}>← 全部文章</a>
        <time datetime={post.data.pubDate.toISOString()}>
          {fmtDate(post.data.pubDate)}
        </time>
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <h1>{post.data.title}</h1>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <aside class="article-foot">
      <div class="foot-row">
        <span class="foot-label">时间</span>
        <span>
          发布于 <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updateDate && (
            <>
              {' · '}最后更新{' '}
              <time datetime={post.data.updateDate.toISOString()}>
                {fmtDate(post.data.updateDate)}
              </time>
            </>
          )}
        </span>
      </div>
      {post.data.tags.length > 0 && (
        <div class="foot-row">
          <span class="foot-label">标签</span>
          <span>{post.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
        </div>
      )}
      <div class="foot-row">
        <span class="foot-label">联系</span>
        <span>
          <a href="https://github.com/rrCathy" target="_blank" rel="noopener">GitHub ↗</a>
          {' · '}
          <a href="mailto:bluejam001@163.com">bluejam001@163.com</a>
          <span class="foot-note">（在线时间 10:00–24:00）</span>
        </span>
      </div>
      <div class="foot-row">
        <span class="foot-label">评论</span>
        <span>
          发现错误或想深入讨论？到{' '}
          <a
            href="https://github.com/rrCathy/blog/issues/new?title=关于「{post.data.title}」"
            target="_blank"
            rel="noopener"
          >
            仓库 Issue
          </a>{' '}
          开一条即可，我会收到通知。
        </span>
      </div>
    </aside>
  </article>
</BaseLayout>
