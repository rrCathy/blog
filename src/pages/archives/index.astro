---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCover from '../../components/PostCover.astro'
import { getAllArchives } from '../../lib/archives'
import { tagTone } from '../../lib/tag-tone'

const years = await getAllArchives()
const base = import.meta.env.BASE_URL
const totalPosts = years.reduce((acc, y) => acc + y.count, 0)

function fmtDate(d: Date) {
  return d.toLocaleDateString('zh-CN', { month: 'long', day: 'numeric' })
}
---
<BaseLayout
  title="rrCathy 的博客"
  pageTitle="归档 · Archives"
  description={`按年份归档的全部 ${totalPosts} 篇文章，最新的在前。`}
>
  <div class="wrap">
    <section class="blog-hero">
      <p class="series-eyebrow">索引</p>
      <h1>归档</h1>
      <p class="sub">共 {totalPosts} 篇文章 · 按年份倒序</p>
    </section>

    {years.length === 0 ? (
      <p class="post-empty">还没有任何文章。</p>
    ) : (
      years.map((y) => (
        <section class="archive-year">
          <h2 class="archive-year-head">
            <span class="archive-year-num">{y.year}</span>
            <span class="archive-year-count">{y.count} 篇</span>
          </h2>
          <ul class="post-list archive-list">
            {y.posts.map((post) => (
              <li class="post-item compact" data-tags={post.data.tags.join(',')}>
                <div class="post-item-body">
                  <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                      {fmtDate(post.data.pubDate)}
                    </time>
                    {post.data.tags.map((t) => (
                      <span class="tag" data-tone={tagTone(t)}>{t}</span>
                    ))}
                  </div>
                  <h2><a href={base + post.id + '/'}>{post.data.title}</a></h2>
                  {post.data.description && (
                    <p class="post-excerpt">{post.data.description}</p>
                  )}
                </div>
                <PostCover
                  cover={post.data.cover}
                  variant="card"
                  seed={post.id}
                  title={post.data.title}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    )}

    <p class="series-back"><a href={base}>← 全部文章</a></p>
  </div>
</BaseLayout>