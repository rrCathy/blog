---
/**
 * 两条成功率的对比 —— 纯静态 SVG。
 * 纵轴是对数刻度（跨 31 个数量级），横轴是人数 n。
 *   随机抽：      (1/2)^n
 *   跟着链条走：  1 - (H_n - H_{n/2})，n 取偶数
 * 配色：结构色走主题变量，两条曲线用固定双色（红 = 瞎抽，青 = 跟随链条）。
 */
interface Props {
  size?: number
  caption?: string
  compact?: boolean
}

const { size = 660, caption, compact = false } = Astro.props

const H = (n: number) => {
  let s = 0
  for (let k = 1; k <= n; k++) s += 1 / k
  return s
}
/** 最优策略的成功率：最长环不超过 n/2 */
const surv = (n: number) => 1 - (H(n) - H(n / 2))

const RED = '#dc2626'
const TEAL = '#0e9488'

const PAD = { l: 66, r: 30, t: 30, b: 50 }
const VW = 660
const VH = 386
const W = VW - PAD.l - PAD.r
const HGT = VH - PAD.t - PAD.b
const LOG_MIN = -31

const x = (n: number) => PAD.l + ((n - 2) / (100 - 2)) * W
const y = (p: number) => PAD.t + (Math.log10(Math.max(p, 1e-31)) / LOG_MIN) * HGT

const SUP = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹']
const sup = (k: number) => String(k).split('').map((d) => SUP[+d]).join('')

const yTicks = [0, -5, -10, -15, -20, -25, -30]
const xTicks = [2, 20, 40, 60, 80, 100]

const randomPts = Array.from({ length: 99 }, (_, k) => {
  const n = k + 2
  return `${x(n).toFixed(1)},${y(Math.pow(0.5, n)).toFixed(1)}`
}).join(' ')

const chainPts = Array.from({ length: 50 }, (_, k) => {
  const n = 2 * (k + 1)
  return `${x(n).toFixed(1)},${y(surv(n)).toFixed(1)}`
}).join(' ')

const p100 = surv(100)
const p4 = surv(4)
const random100 = Math.pow(0.5, 100)
const aria = `成功率对比：随机抽是 (1/2)^n，跟着链条走是 1-(H_n-H_{n/2})，n=100 时前者约 10 的负 30 次方，后者 31.2%`
---

<figure class={'sc' + (compact ? ' is-compact' : '')} style={`--sc-max:${size}px`}>
  <svg viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label={aria}>
    {
      yTicks.map((t) => (
        <>
          <line x1={PAD.l} y1={y(Math.pow(10, t))} x2={VW - PAD.r} y2={y(Math.pow(10, t))} stroke="var(--border)" stroke-width="1" />
          <text x={PAD.l - 10} y={y(Math.pow(10, t))} text-anchor="end" dominant-baseline="central" font-size="12" fill="var(--text-dim)">
            {t === 0 ? '1' : `10${sup(-t)}`}
          </text>
        </>
      ))
    }

    {
      xTicks.map((t) => (
        <>
          <line x1={x(t)} y1={PAD.t} x2={x(t)} y2={VH - PAD.b} stroke="var(--border)" stroke-width="1" stroke-dasharray="2 4" />
          <text x={x(t)} y={VH - PAD.b + 20} text-anchor="middle" font-size="12" fill="var(--text-dim)">
            {t}
          </text>
        </>
      ))
    }
    <text x={PAD.l + W / 2} y={VH - 12} text-anchor="middle" font-size="12.5" fill="var(--text-soft)">
      人数 n
    </text>

    {/* n=100 处跨 30 个数量级的落差 */}
    <line x1={x(100)} y1={y(p100)} x2={x(100)} y2={y(random100)} stroke="var(--text-dim)" stroke-width="1.2" stroke-dasharray="3 3" />
    <text x={x(100) - 8} y={(y(p100) + y(random100)) / 2} text-anchor="end" font-size="12.5" fill="var(--text-soft)">
      差 30 个数量级
    </text>

    <polyline points={randomPts} fill="none" stroke={RED} stroke-width="2.4" stroke-linecap="round" />
    <polyline points={chainPts} fill="none" stroke={TEAL} stroke-width="3" stroke-linecap="round" />

    <circle cx={x(4)} cy={y(p4)} r="4.5" fill={TEAL} />
    <text x={x(4) + 9} y={y(p4) - 11} font-size="12.5" fill="var(--text-soft)">
      n=4 · 41.7%
    </text>

    <circle cx={x(100)} cy={y(p100)} r="4.5" fill={TEAL} />
    <text x={x(100) - 8} y={y(p100) - 12} text-anchor="end" font-size="12.5" font-weight="600" fill={TEAL}>
      31.2%
    </text>

    <circle cx={x(100)} cy={y(random100)} r="4.5" fill={RED} />
    <text x={x(100) - 8} y={y(random100) + 16} text-anchor="end" font-size="12.5" font-weight="600" fill={RED}>
      (1/2)¹⁰⁰
    </text>
  </svg>
  {
    !compact && (
      <div class="sc-legend">
        <span class="sc-key">
          <i style={`background:${RED}`} />每个人瞎抽 50 个
        </span>
        <span class="sc-key">
          <i style={`background:${TEAL}`} />跟着卡片走
        </span>
      </div>
    )
  }
  {!compact && caption && <figcaption set:html={caption} />}
</figure>

<style>
  .sc {
    margin: 1.6rem 0;
  }
  .sc.is-compact {
    margin: 0;
  }
  .sc svg {
    width: 100%;
    max-width: var(--sc-max);
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .sc-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.2rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-soft);
  }
  .sc-key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .sc-key i {
    width: 14px;
    height: 3.5px;
    border-radius: 2px;
    display: inline-block;
  }
  .sc figcaption {
    margin-top: 0.55rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    text-align: center;
  }
</style>
