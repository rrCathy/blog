---
/**
 * n=100 随机排列里「最长环」的精确分布 —— 纯静态 SVG 柱状图。
 *
 * 分布不靠模拟。递推 F(n,m) = (1/n) · Σ_{k=1..min(m,n)} F(n−k, m) 精确给出
 * P(最长环 ≤ m)，依据是「任一元素所在环的长度恰为 k」的概率 = 1/n（与 k 无关）；
 * P(L = ℓ) = F(n,ℓ) − F(n,ℓ−1)。小 n 已与全枚举逐位对齐（n = 2..8），
 * 期望 62.74 与 20 万次模拟（62.76）一致。
 *
 * 配色沿用 SurvivalCurve：青 = 全员活的一侧，红 = 全员死的一侧。
 */
interface Props {
  size?: number
  caption?: string
  compact?: boolean
}

const { size = 660, caption, compact = false } = Astro.props

const N = 100
const memo = new Map()
const F = (n: number, m: number): number => {
  if (n === 0) return 1
  const key = n * 1000 + m
  if (memo.has(key)) return memo.get(key)
  let s = 0
  const top = Math.min(m, n)
  for (let k = 1; k <= top; k++) s += F(n - k, m)
  const v = s / n
  memo.set(key, v)
  return v
}

const prob: number[] = []
for (let l = 1; l <= N; l++) prob.push(F(N, l) - F(N, l - 1))
const eL = prob.reduce((s, p, i) => s + p * (i + 1), 0)

const TEAL = '#0e9488'
const RED = '#dc2626'

const VW = 660
const VH = 318
const PAD = { l: 56, r: 16, t: 18, b: 46 }
const W = VW - PAD.l - PAD.r
const H = VH - PAD.t - PAD.b
const maxP = Math.max(...prob)
const yMax = Math.ceil(maxP / 0.005) * 0.005

const x = (l: number) => PAD.l + ((l - 0.5) / N) * W
const y = (p: number) => PAD.t + H - (p / yMax) * H
const bw = W / N - 0.9

const yStep = 0.005
const yTicks: number[] = []
for (let v = 0; v <= yMax + 1e-9; v += yStep) yTicks.push(v)
const xTicks = [1, 25, 50, 75, 100]

const midX = PAD.l + (50 / N) * W
const eX = PAD.l + ((eL - 0.5) / N) * W
const fmtPct = (v: number) => (v * 100).toFixed(1) + '%'
const aria = `一百个元素的随机排列，最长环长度的精确分布：不超过 50 的概率 31.18%，期望 62.7`
---

<figure class={'ch' + (compact ? ' is-compact' : '')} style={`--ch-max:${size}px`}>
  <svg viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label={aria}>
    {
      yTicks.map((t) => (
        <>
          <line x1={PAD.l} y1={y(t)} x2={VW - PAD.r} y2={y(t)} stroke="var(--border)" stroke-width="1" />
          <text x={PAD.l - 8} y={y(t)} text-anchor="end" dominant-baseline="central" font-size="11.5" fill="var(--text-dim)">
            {fmtPct(t)}
          </text>
        </>
      ))
    }

    {
      xTicks.map((t) => (
        <text x={x(t)} y={VH - PAD.b + 20} text-anchor="middle" font-size="12" fill="var(--text-dim)">
          {t}
        </text>
      ))
    }
    <text x={PAD.l + W / 2} y={VH - 12} text-anchor="middle" font-size="12.5" fill="var(--text-soft)">
      最长环的长度 ℓ
    </text>

    {/* 活 / 死分界：ℓ = 50 */}
    <line x1={midX} y1={PAD.t - 4} x2={midX} y2={VH - PAD.b} stroke="var(--text-dim)" stroke-width="1.2" stroke-dasharray="4 3" />
    <text x={midX - 7} y={PAD.t + 4} text-anchor="end" font-size="12" fill="var(--text-soft)">
      50：活与死的分界
    </text>

    {/* 期望位置 */}
    <line x1={eX} y1={PAD.t + 18} x2={eX} y2={VH - PAD.b} stroke="var(--text-soft)" stroke-width="1" stroke-dasharray="2 3" />
    <text x={eX + 7} y={PAD.t + 26} font-size="12" fill="var(--text-soft)">
      平均 {eL.toFixed(1)}
    </text>

    {
      prob.map((p, i) => {
        const l = i + 1
        return (
          <rect
            x={x(l) - bw / 2}
            y={y(p)}
            width={bw}
            height={y(0) - y(p)}
            fill={l <= 50 ? TEAL : RED}
            opacity="0.85"
          />
        )
      })
    }
  </svg>
  {
    !compact && (
      <div class="ch-legend">
        <span class="ch-key">
          <i style={`background:${TEAL}`} />最长环 ≤ 50，全员活
        </span>
        <span class="ch-key">
          <i style={`background:${RED}`} />最长环 &gt; 50，全员死
        </span>
      </div>
    )
  }
  {!compact && caption && <figcaption set:html={caption} />}
</figure>

<style>
  .ch {
    margin: 1.6rem 0;
  }
  .ch.is-compact {
    margin: 0;
  }
  .ch svg {
    width: 100%;
    max-width: var(--ch-max);
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .ch-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.2rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-soft);
  }
  .ch-key {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .ch-key i {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
  }
  .ch figcaption {
    margin-top: 0.55rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    text-align: center;
  }
</style>
